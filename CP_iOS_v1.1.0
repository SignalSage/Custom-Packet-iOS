            width,
            44
        )

        y += 52

        self.status.frame = (
            padding,
            y,
            width,
            20
        )

        y += 28

        self.last_info.frame = (
            padding,
            y,
            width,
            max(
                50,
                self.height
                - y
                - padding
            )
        )

    def set_status(self, text):
        self.status.text = text

    def on_play(self, sender):
        try:
            self.set_status(
                'Building packet...'
            )

            source = (
                self.src.text.strip()
                or 'N0CALL-1'
            )

            destination = (
                self.dest.text.strip()
                or 'APRS'
            )

            path = [
                item.strip()
                for item in (
                    self.path.text
                    or ''
                ).split(',')
                if item.strip()
            ]

            comment = (
                self.comment.text
                or ''
            ).strip()

            info = comment
            
            baud = clamp(
                safe_int(
                    self.baud.text,
                    9600
                ),
                1,
                9600
            )

            mark = safe_float(
                self.mark.text,
                1200.0
            )

            space = safe_float(
                self.space.text,
                2200.0
            )

            frame = ax25_frame(
                source,
                destination,
                path,
                info
            )

            audio = afsk_encode(
                frame,
                baud=baud,
                mark=mark,
                space=space,
                sample_rate=TX_SAMPLE_RATE,
                nrzi_polarity=NRZI_POLARITY
            )

            loopback_text = ''

            if self.loopback_switch.value:
                self.set_status(
                    'Internal decode...'
                )

                packets, stats = (
                    decode_audio_samples(
                        audio,
                        TX_SAMPLE_RATE,
                        baud,
                        mark,
                        space
                    )
                )

                loopback_lines = [
                    '',
                    'Instant internal decode:',
                    (
                        'audio={:.3f}s '
                        'symbols={} '
                        'flags={} '
                        'frames={} '
                        'crc={}'
                    ).format(
                        stats.get(
                            'audio_seconds',
                            0.0
                        ),
                        stats.get(
                            'symbols',
                            0
                        ),
                        stats.get(
                            'flag_count',
                            0
                        ),
                        stats.get(
                            'parsed_packets',
                            0
                        ),
                        stats.get(
                            'crc_ok',
                            0
                        )
                    ),
                    (
                        'requested={:.2f} '
                        'recovered={:.2f} '
                        'phase_error={:.4f}'
                    ).format(
                        float(baud),
                        stats.get(
                            'recovered_baud',
                            0.0
                        ),
                        stats.get(
                            'mean_phase_error',
                            0.0
                        )
                    )
                ]

                if packets:
                    for (
                        addresses,
                        decoded_info,
                        crc_ok
                    ) in packets:
                        decoded_destination = (
                            addresses[0]
                            if len(addresses) > 0
                            else '?'
                        )

                        decoded_source = (
                            addresses[1]
                            if len(addresses) > 1
                            else '?'
                        )

                        decoded_path = (
                            ','.join(
                                addresses[2:]
                            )
                            if len(addresses) > 2
                            else '-'
                        )

                        loopback_lines.append(
                            (
                                '{} > {} via {} '
                                'CRC:{}'
                            ).format(
                                decoded_source,
                                decoded_destination,
                                decoded_path,
                                (
                                    'OK'
                                    if crc_ok
                                    else 'BAD'
                                )
                            )
                        )

                        loopback_lines.append(
                            decoded_info.decode(
                                'ascii',
                                'replace'
                            )
                        )
                else:
                    error_text = stats.get(
                        'error'
                    )

                    if error_text:
                        loopback_lines.append(
                            'Decoder error: {}'.format(
                                error_text
                            )
                        )
                    else:
                        loopback_lines.append(
                            'No packet decoded.'
                        )

                loopback_text = '\n'.join(
                    loopback_lines
                )

            filename = (
                'pkt_{}.wav'.format(
                    datetime.now().strftime(
                        '%H%M%S'
                    )
                )
            )

            save_to_wav(
                audio,
                filename,
                TX_SAMPLE_RATE
            )

            play_audio(filename)

            self.last_info.text = (
                'Built info:\n'
                '{}\n\n'
                'Baud/Mark/Space: '
                '{} / {:.1f} / {:.1f}\n'
                'Frame bytes: {}\n'
                'Audio samples: {}\n'
                'WAV: {}\n'
                '{}\n'
            ).format(
                info,
                baud,
                mark,
                space,
                len(frame),
                len(audio),
                filename,
                loopback_text
            )

            self.set_status(
                'Played.'
            )

        except Exception as error:
            self.set_status(
                'Error: {!r}'.format(
                    error
                )
            )


