        self.baud.frame = (
            padding,
            y,
            third_width,
            field_height
        )

        self.mark.frame = (
            padding
            + third_width
            + 8,
            y,
            third_width,
            field_height
        )

        self.space.frame = (
            padding
            + 2 * (
                third_width + 8
            ),
            y,
            third_width,
            field_height
        )

        y += field_height + 10

        button_width = (
            width - 10
        ) / 2.0

        self.start_btn.frame = (
            padding,
            y,
            button_width,
            44
        )

        self.stop_btn.frame = (
            padding
            + button_width
            + 10,
            y,
            button_width,
            44
        )

        y += 54

        self.status.frame = (
            padding,
            y,
            width,
            20
        )

        y += 28

        self.out.frame = (
            padding,
            y,
            width,
            max(
                50,
                self.height
                - y
                - padding
            )
        )

    def set_status(self, text):
        self.status.text = text

    def _append_lines_mainthread(
        self,
        lines
    ):
        text = (
            self.out.text
            + '\n'.join(lines)
            + '\n'
        )

        if len(text) > MAX_LOG_CHARS:
            text = text[
                -MAX_LOG_CHARS:
            ]

        self.out.text = text

        self.out.content_offset = (
            0,
            max(
                0,
                self.out.content_size[1]
                - self.out.height
            )
        )

    def start_rx(self, sender):
        if (
            self._recorder
            or self._decoding
        ):
            return

        self.out.text = ''

        self._filename = (
            'rx_capture_{}.wav'.format(
                datetime.now().strftime(
                    '%Y%m%d_%H%M%S'
                )
            )
        )

        self._recorder = sound.Recorder(
            self._filename
        )

        try:
            self._recorder.record(
                MAX_RECORD_SECONDS
            )
        except Exception:
            self._recorder.record()

        self.start_btn.enabled = False
        self.stop_btn.enabled = True

        self.set_status(
            'Recording...'
        )

    def stop_rx(self, sender):
        if (
            not self._recorder
            or self._decoding
        ):
            return

        baud = clamp(
            safe_int(
                self.baud.text,
                9600
            ),
            1,
            9600
        )

        mark = safe_float(
            self.mark.text,
            1200.0
        )

        space = safe_float(
            self.space.text,
            2200.0
        )

        try:
            self._recorder.stop()
        except Exception:
            pass

        self._recorder = None
        self._decoding = True

        self.stop_btn.enabled = False

        self.set_status(
            'Finalizing WAV...'
        )

        thread = threading.Thread(
            target=self._decode_worker,
            args=(
                self._filename,
                baud,
                mark,
                space
            )
        )

        thread.daemon = True
        thread.start()

    def _decode_worker(
        self,
        filename,
        baud,
        mark,
        space
    ):
        lines = []

        try:
            wait_for_file_stable(
                filename,
                stable_sec=0.5,
                timeout=(
                    FINALIZE_WAIT_SEC
                    + 2.0
                )
            )

            if (
                not os.path.exists(filename)
                or os.path.getsize(filename)
                <= 44
            ):
                lines.append(
                    '[warn] no readable audio captured'
                )
            else:
                samples, sample_rate = (
                    read_wav_all(filename)
                )

                decoder = AFSKDecoder(
                    baud=baud,
                    mark=mark,
                    space=space,
                    sample_rate=TARGET_SR,
                    nrzi_polarity=NRZI_POLARITY,
                    roll_sec=None
                )

                decoder.push(
                    samples,
                    sample_rate
                )

                packets = decoder.decode()
                stats = decoder.last_stats

                lines.append(
                    (
                        '[modem] '
                        'audio={:.2f}s '
                        'symbols={} '
                        'flags={} '
                        'frames={} '
                        'crc={}'
                    ).format(
                        stats.get(
                            'audio_seconds',
                            0.0
                        ),
                        stats.get(
                            'symbols',
                            0
                        ),
                        stats.get(
                            'flag_count',
                            0
                        ),
                        stats.get(
                            'parsed_packets',
                            0
                        ),
                        stats.get(
                            'crc_ok',
                            0
                        )
                    )
                )

                lines.append(
                    (
                        '[clock] '
                        'requested={:.2f} '
                        'recovered={:.2f} '
                        'error={:.4f}'
                    ).format(
                        float(baud),
                        stats.get(
                            'recovered_baud',
                            0.0
                        ),
                        stats.get(
                            'mean_phase_error',
                            0.0
                        )
                    )
                )

                if stats.get('error'):
                    lines.append(
                        '[decoder] {}'.format(
                            stats['error']
                        )
                    )

                lines.append('')

                displayed_packet = False

                for (
                    addresses,
                    info,
                    crc_ok
                ) in packets:
                    if (
                        SHOW_ONLY_CRC_OK
                        and not crc_ok
                    ):
                        continue

                    displayed_packet = True

                    destination = (
                        addresses[0]
                        if len(addresses) > 0
                        else '?'
                    )

                    source = (
                        addresses[1]
                        if len(addresses) > 1
                        else '?'
                    )

                    path = (
                        ','.join(
                            addresses[2:]
                        )
                        if len(addresses) > 2
                        else '-'
                    )

                    lines.append(
                        (
                            '{} > {} via {} '
                            'CRC:{}'
                        ).format(
                            source,
                            destination,
                            path,
                            (
                                'OK'
                                if crc_ok
                                else 'BAD'
                            )
                        )
                    )

                    lines.append(
                        info.decode(
                            'ascii',
                            'replace'
                        )
                    )

                    lines.append('')

                if not displayed_packet:
                    lines.append(
                        '[decode] no frames found'
                    )

        except Exception as error:
            lines.append(
                '[decode error] {!r}'.format(
                    error
                )
            )

        def finish():
            self._append_lines_mainthread(
                lines
            )

            self._decoding = False

            self.start_btn.enabled = True
            self.stop_btn.enabled = False

            self.set_status(
                'Done.'
            )

        run_ui(finish)


# =========================
# App container
# =========================

class App(ui.View):
    def __init__(self):
        super().__init__()

        self.name = (
            'Custom Packet TX/RX'
        )

        self.bg_color = '#0b0d10'

        self.segmented_control = (
            ui.SegmentedControl(
                segments=[
                    'TX',
                    'RX'
                ]
            )
        )

        self.segmented_control.selected_index = 0

        self.segmented_control.action = (
            self.on_tab
        )

        self.add_subview(
            self.segmented_control
        )

        self.tx_view = TXView()
        self.rx_view = RXView()

        self.add_subview(
            self.tx_view
        )

        self.add_subview(
            self.rx_view
        )

        self.on_tab(
            self.segmented_control
        )

    def layout(self):
        padding = 10

        self.segmented_control.frame = (
            padding,
            padding,
            self.width
            - 2 * padding,
            32
        )

        content_y = (
            padding + 40
        )

        content_height = (
            self.height
            - content_y
            - padding
        )

        self.tx_view.frame = (
            0,
            content_y,
            self.width,
            content_height
        )

        self.rx_view.frame = (
            0,
            content_y,
            self.width,
            content_height
        )

    def on_tab(self, sender):
        selected_index = (
            self.segmented_control
            .selected_index
        )

        self.tx_view.hidden = (
            selected_index != 0
        )

        self.rx_view.hidden = (
            selected_index != 1
        )


App().present('fullscreen')
