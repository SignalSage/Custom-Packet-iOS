        self.title.frame = (
            padding,
            y,
            width,
            28
        )

        y += 36

        self.src.frame = (
            padding,
            y,
            width,
            field_height
        )

        y += field_height + 8

        self.dest.frame = (
            padding,
            y,
            width,
            field_height
        )

        y += field_height + 8

        self.path.frame = (
            padding,
            y,
            width,
            field_height
        )

        y += field_height + 8

        self.comment.frame = (
            padding,
            y,
            width,
            field_height
        )

        y += field_height + 8

        third_width = (
            width - 16
        ) / 3.0

        self.baud.frame = (
            padding,
            y,
            third_width,
            field_height
        )

        self.mark.frame = (
            padding
            + third_width
            + 8,
            y,
            third_width,
            field_height
        )

        self.space.frame = (
            padding
            + 2 * (
                third_width + 8
            ),
            y,
            third_width,
            field_height
        )

        y += field_height + 10

        self.use_gps.frame = (
            padding,
            y,
            60,
            32
        )

        self.gps_label.frame = (
            padding + 70,
            y + 5,
            width - 70,
            24
        )

        y += 40

        half_width = (
            width - 8
        ) / 2.0

        self.manual_lat.frame = (
            padding,
            y,
            half_width,
            field_height
        )

        self.manual_lon.frame = (
            padding
            + half_width
            + 8,
            y,
            half_width,
            field_height
        )

        y += field_height + 12

        self.loopback_switch.frame = (
            padding,
            y,
            60,
            32
        )

        self.loopback_label.frame = (
            padding + 70,
            y + 5,
            width - 70,
            24
        )

        y += 40

        self.play_btn.frame = (
